{
  "name": "birrstack-core",
  "version": "0.0.1",
  "description": "BirrStack core runtime — signals, components, router. BismiLLAH.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "import": "./dist/signals/index.js"
    },
    "./component": {
      "types": "./dist/component/index.d.ts",
      "import": "./dist/component/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
