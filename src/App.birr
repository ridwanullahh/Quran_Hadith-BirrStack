<template>
  <div class="app" data-theme="{{ theme }}">
    <header class="header">
      <div class="header-content">
        <div class="header-title" birr:on:click="goHome">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L2 7v10l10 5 10-5V7L12 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M12 22V12M2 7l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          <span>Quran & Hadith</span>
        </div>
        <div class="header-actions">
          <select class="translation-select" birr:on:change="onTranslationChange">
            <option birr:for="tr in translations" birr:key="tr.code" value="{{ tr.code }}">{{ tr.name }}</option>
          </select>
          <button class="theme-toggle" birr:on:click="toggleTheme" aria-label="Toggle theme">
            <svg birr:if="isLight" width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg birr:if="isDark" width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="main">
      <div birr:if="isHome" class="page">
        <div class="home-hero">
          <p class="bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
          <p class="bismillah-translation">In the name of Allah, the Entirely Merciful, the Especially Merciful.</p>
        </div>

        <div class="daily-section" birr:if="dailyHadith">
          <h3 class="section-title">Hadith of the Moment</h3>
          <div class="daily-card" birr:on:click="goHadith">
            <p class="daily-arabic">{{ dailyHadith.arabic }}</p>
            <p class="daily-english">{{ dailyHadith.english }}</p>
            <p class="daily-source">{{ dailyHadith.collection }} #{{ dailyHadith.number }}</p>
          </div>
        </div>

        <div class="home-cards">
          <div class="home-card home-card-quran" birr:on:click="goQuran">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h3>Al-Quran</h3>
            <p>114 Surahs - 10 translations</p>
          </div>
          <div class="home-card home-card-hadith" birr:on:click="goHadith">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h3>Hadith</h3>
            <p>{{ hadithStatsText }}</p>
          </div>
        </div>

        <div class="home-section">
          <h3 class="section-title">Quick Access</h3>
          <div class="quick-surahs">
            <div class="quick-surah" birr:for="s in quickSurahs" birr:key="s.number" birr:on:click="openSurah(s.number)">
              <span class="quick-surah-num">{{ s.number }}</span>
              <span class="quick-surah-name">{{ s.transliteration }}</span>
              <span class="quick-surah-arabic">{{ s.name }}</span>
            </div>
          </div>
        </div>
      </div>

      <div birr:if="isQuranList" class="page">
        <h2 class="page-title">Al-Quran</h2>
        <p class="page-subtitle">114 Surahs - Full text with 10 translations</p>
        <div class="surah-list">
          <div birr:for="surah in allSurahs" birr:key="surah.number" class="surah-item" birr:on:click="openSurah(surah.number)">
            <div class="surah-number">{{ surah.number }}</div>
            <div class="surah-info">
              <div class="surah-name">{{ surah.transliteration }}</div>
              <div class="surah-meta">{{ surah.englishName }} - {{ surah.ayahs }} ayahs - {{ surah.type }}</div>
            </div>
            <div class="surah-arabic">{{ surah.name }}</div>
          </div>
        </div>
      </div>

      <div birr:if="isSurah" class="page">
        <div class="surah-header">
          <button class="back-btn" birr:on:click="goQuran">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="surah-header-info">
            <h2 class="surah-header-name">{{ currentSurahName }}</h2>
            <p class="surah-header-meta">{{ currentSurahType }} - {{ currentSurahAyahCount }} ayahs</p>
          </div>
          <select class="reciter-select" birr:on:change="onReciterChange">
            <option birr:for="r in reciters" birr:key="r.id" value="{{ r.id }}">{{ r.name }}</option>
          </select>
        </div>

        <div birr:if="isLoadingSurah" class="loading">
          <p>Loading surah...</p>
        </div>

        <div birr:if="!isLoadingSurah" class="ayah-list">
          <p class="bismillah" birr:if="currentSurahNumber !== 1 && currentSurahNumber !== 9">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>
          <div birr:for="ayah in currentAyahs" birr:key="ayah.number" class="ayah-item" id="ayah-{{ ayah.number }}">
            <div class="ayah-top">
              <div class="ayah-number-circle">{{ ayah.number }}</div>
              <div class="ayah-actions">
                <button class="ayah-action-btn" birr:on:click="playAyah(ayah.number)" aria-label="Play audio">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 3l14 9-14 9V3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                </button>
                <button class="ayah-action-btn" birr:on:click="toggleBookmark(surahNumber, ayah.number)" aria-label="Bookmark">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                </button>
                <button class="ayah-action-btn" birr:on:click="downloadAyahAudio(ayah.number)" aria-label="Download audio">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
            <p class="ayah-arabic">{{ ayah.arabic }}</p>
            <p birr:if="ayah.transliteration" class="ayah-transliteration">{{ ayah.transliteration }}</p>
            <p class="ayah-translation">{{ ayah.translations[currentTranslation] || ayah.translations.en || '' }}</p>
          </div>
        </div>
      </div>

      <div birr:if="isHadithList" class="page">
        <h2 class="page-title">Hadith Collections</h2>
        <p class="page-subtitle">{{ hadithStatsText }}</p>
        <div class="collection-list">
          <div birr:for="col in hadithCollections" birr:key="col.key" class="collection-item" birr:on:click="openCollection(col.key)">
            <div class="collection-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="collection-info">
              <div class="collection-name">{{ col.name }}</div>
              <div class="collection-arabic">{{ col.arabicName }}</div>
              <div class="collection-count">{{ col.count }} hadiths</div>
            </div>
          </div>
        </div>
      </div>

      <div birr:if="isHadithCollection" class="page">
        <div class="surah-header">
          <button class="back-btn" birr:on:click="goHadith">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="surah-header-info">
            <h2 class="surah-header-name">{{ currentCollectionName }}</h2>
            <p class="surah-header-meta">{{ currentHadithsCount }} hadiths</p>
          </div>
        </div>
        <div class="hadith-list">
          <div birr:for="hadith in currentHadiths" birr:key="hadith.urn" class="hadith-item">
            <div class="hadith-meta">
              <span class="hadith-number">#{{ hadith.number }}</span>
              <span birr:if="hadith.grade" class="hadith-grade">{{ hadith.grade }}</span>
            </div>
            <p class="hadith-arabic">{{ hadith.arabic }}</p>
            <p class="hadith-english">{{ hadith.english }}</p>
            <p birr:if="hadith.narrator" class="hadith-narrator">Narrated by: {{ hadith.narrator }}</p>
          </div>
        </div>
      </div>

      <div birr:if="isSearch" class="page">
        <h2 class="page-title">Search</h2>
        <input class="search-input" placeholder="Search Quran and Hadith..." birr:on:input="onSearchInput" value="{{ searchQuery }}" />
        <div birr:if="searchQuery" class="search-results">
          <p class="search-summary">{{ searchResults.length }} results</p>
          <div birr:for="result in searchResults" birr:key="result.id" class="search-result-item" birr:on:click="openSearchResult(result)">
            <span class="result-type">{{ result.type }}</span>
            <p class="result-text">{{ result.text }}</p>
          </div>
        </div>
        <p birr:if="!searchQuery" class="home-muted">Type to search across Quran and Hadith. Hadith search works offline. Quran search works on loaded surahs.</p>
      </div>

      <div birr:if="isBookmarks" class="page">
        <h2 class="page-title">Saved Items</h2>
        <p birr:if="bookmarks.length === 0" class="home-muted">No saved items yet. Bookmark ayahs and hadiths to find them here.</p>
        <div birr:if="bookmarks.length > 0" class="bookmark-list">
          <div birr:for="bm in bookmarks" birr:key="bm.id" class="bookmark-item" birr:on:click="openBookmark(bm)">
            <span class="result-type">{{ bm.type }}</span>
            <p class="result-text">{{ bm.label }}</p>
            <button class="delete-bookmark" birr:on:click="deleteBookmark(bm.id)">Remove</button>
          </div>
        </div>
      </div>
    </main>

    <nav class="bottom-nav">
      <button class="nav-item {{ navHomeClass }}" birr:on:click="goHome">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Home</span>
      </button>
      <button class="nav-item {{ navQuranClass }}" birr:on:click="goQuran">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Quran</span>
      </button>
      <button class="nav-item {{ navHadithClass }}" birr:on:click="goHadith">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Hadith</span>
      </button>
      <button class="nav-item {{ navSearchClass }}" birr:on:click="goSearch">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Search</span>
      </button>
      <button class="nav-item {{ navBookmarksClass }}" birr:on:click="goBookmarks">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Saved</span>
      </button>
    </nav>
  </div>
</template>

<script>
import { signal, computed } from 'birrstack-core';
import { TRANSLATIONS, RECITERS, loadSurah, getAyahAudioUrl, SURAHS_META } from './data/quran-service';
import { getCollections, getHadiths, searchHadiths, getRandomHadith, getCollectionCount, TOTAL_HADITHS } from './data/hadith-service';
import { getThemeSignal, toggleTheme } from './lib/theme';
import { getBookmarks, addBookmark, removeBookmark } from './lib/db';

// Full surah list (all 114)
const ALL_SURAHS = [];
for (let i = 1; i <= 114; i++) {
  const meta = SURAHS_META.find(s => s.number === i);
  if (meta) {
    ALL_SURAHS.push(meta);
  } else {
    ALL_SURAHS.push({ number: i, name: '', transliteration: `Surah ${i}`, englishName: '', ayahs: 0, type: '' });
  }
}

export default {
  setup() {
    const theme = getThemeSignal();
    const isLight = computed(() => theme.value === 'light');
    const isDark = computed(() => theme.value === 'dark');

    const routeName = signal('home');
    const routeParams = signal({});

    function handleHashChange() {
      const hash = window.location.hash.slice(2) || '';
      const parts = hash.split('/');
      const route = parts[0] || '';
      if (route === '') { routeName.value = 'home'; routeParams.value = {}; loadDailyHadith(); }
      else if (route === 'quran' && !parts[1]) { routeName.value = 'quran-list'; }
      else if (route === 'quran' && parts[1]) { routeName.value = 'surah'; routeParams.value = { number: parts[1] }; loadSurahData(Number(parts[1])); }
      else if (route === 'hadith' && !parts[1]) { routeName.value = 'hadith-list'; }
      else if (route === 'hadith' && parts[1]) { routeName.value = 'hadith-collection'; routeParams.value = { collection: parts[1] }; loadCollectionData(parts[1]); }
      else if (route === 'search') { routeName.value = 'search'; }
      else if (route === 'bookmarks') { routeName.value = 'bookmarks'; loadBookmarks(); }
      else { routeName.value = 'home'; }
      window.scrollTo(0, 0);
    }
    window.addEventListener('hashchange', handleHashChange);

    const isHome = computed(() => routeName.value === 'home');
    const isQuranList = computed(() => routeName.value === 'quran-list');
    const isSurah = computed(() => routeName.value === 'surah');
    const isHadithList = computed(() => routeName.value === 'hadith-list');
    const isHadithCollection = computed(() => routeName.value === 'hadith-collection');
    const isSearch = computed(() => routeName.value === 'search');
    const isBookmarks = computed(() => routeName.value === 'bookmarks');

    const navHomeClass = computed(() => isHome.value ? 'nav-active' : '');
    const navQuranClass = computed(() => (isQuranList.value || isSurah.value) ? 'nav-active' : '');
    const navHadithClass = computed(() => (isHadithList.value || isHadithCollection.value) ? 'nav-active' : '');
    const navSearchClass = computed(() => isSearch.value ? 'nav-active' : '');
    const navBookmarksClass = computed(() => isBookmarks.value ? 'nav-active' : '');

    // Translations
    const translations = TRANSLATIONS;
    const currentTranslation = signal('en');
    function onTranslationChange(e) { currentTranslation.value = e.target.value; }

    // Reciters
    const reciters = RECITERS;
    const currentReciter = signal('ar_alafasy');
    function onReciterChange(e) { currentReciter.value = e.target.value; }

    // Quran data
    const allSurahs = ALL_SURAHS;
    const quickSurahs = [1, 36, 55, 56, 67, 112, 113, 114].map(n => ALL_SURAHS[n - 1]).filter(Boolean);
    const surahNumber = signal(1);
    const currentSurahNumber = computed(() => surahNumber.value);
    const currentSurahName = computed(() => {
      const s = ALL_SURAHS[surahNumber.value - 1];
      return s ? s.transliteration : '';
    });
    const currentSurahType = computed(() => {
      const s = ALL_SURAHS[surahNumber.value - 1];
      return s ? s.type : '';
    });
    const currentSurahAyahCount = computed(() => {
      const s = ALL_SURAHS[surahNumber.value - 1];
      return s ? s.ayahs : 0;
    });
    const currentAyahs = signal([]);
    const isLoadingSurah = signal(false);

    async function loadSurahData(num) {
      surahNumber.value = num;
      isLoadingSurah.value = true;
      currentAyahs.value = [];
      try {
        const surah = await loadSurah(num, currentTranslation.value);
        currentAyahs.value = surah.ayahs;
      } catch (e) {
        console.error('Failed to load surah:', e);
      }
      isLoadingSurah.value = false;
    }

    // Audio
    let currentAudio = null;
    function playAyah(ayahNum) {
      if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      const url = getAyahAudioUrl(surahNumber.value, ayahNum, currentReciter.value);
      currentAudio = new Audio(url);
      currentAudio.play().catch(e => console.error('Audio error:', e));
    }

    async function downloadAyahAudio(ayahNum) {
      try {
        const url = getAyahAudioUrl(surahNumber.value, ayahNum, currentReciter.value);
        const resp = await fetch(url);
        const blob = await resp.blob();
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `${surahNumber.value}-${ayahNum}.mp3`;
        a.click();
        URL.revokeObjectURL(a.href);
      } catch (e) { console.error('Download error:', e); }
    }

    // Hadith data — 16 collections, full counts from BirrDB extraction
    const hadithCollections = getCollections().map(c => ({ ...c, count: getCollectionCount(c.key) }));
    const hadithStatsText = `${hadithCollections.length} Collections - ${TOTAL_HADITHS.toLocaleString()} hadiths`;
    const currentHadiths = signal([]);
    const currentHadithsCount = computed(() => currentHadiths.value.length);
    const currentCollectionName = computed(() => {
      const c = getCollections().find(col => col.key === routeParams.value.collection);
      return c ? c.name : '';
    });

    async function loadCollectionData(key) {
      currentHadiths.value = [];
      try {
        currentHadiths.value = await getHadiths(key);
      } catch (e) { console.error('Hadith load error:', e); }
    }

    // Daily hadith
    const dailyHadith = signal(null);
    async function loadDailyHadith() {
      if (dailyHadith.value) return;
      try {
        const { collection, hadith } = await getRandomHadith();
        dailyHadith.value = { ...hadith, collection: collection };
      } catch (e) { console.error('Daily hadith error:', e); }
    }

    // Search
    const searchQuery = signal('');
    const searchResults = signal([]);

    async function onSearchInput(e) {
      const q = e.target.value;
      searchQuery.value = q;
      if (!q.trim()) { searchResults.value = []; return; }
      try {
        const hadithResults = (await searchHadiths(q)).map(r => ({
          id: r.hadith.urn,
          type: `Hadith - ${r.collection}`,
          text: r.hadith.english.slice(0, 150) + '...',
          action: () => { window.location.hash = '#/hadith/' + r.collection; },
        }));
        searchResults.value = hadithResults;
      } catch (err) { console.error('Search error:', err); }
    }

    function openSearchResult(result) {
      if (result.action) result.action();
    }

    // Bookmarks
    const bookmarks = signal([]);

    async function loadBookmarks() {
      try { bookmarks.value = await getBookmarks(); }
      catch (e) { bookmarks.value = []; }
    }

    async function toggleBookmark(sNum, aNum) {
      try {
        const meta = ALL_SURAHS[sNum - 1];
        const label = `${meta?.transliteration || 'Surah'} ${sNum}:${aNum}`;
        const bms = await getBookmarks();
        const existing = bms.find(b => b.type === 'ayah' && b.surahNumber === sNum && b.ayahNumber === aNum);
        if (existing) {
          await removeBookmark(existing.id);
        } else {
          await addBookmark({ type: 'ayah', surahNumber: sNum, ayahNumber: aNum, label });
        }
        loadBookmarks();
      } catch (e) { console.error('Bookmark error:', e); }
    }

    async function deleteBookmark(id) {
      await removeBookmark(id);
      loadBookmarks();
    }

    function openBookmark(bm) {
      if (bm.type === 'ayah') { window.location.hash = '#/quran/' + bm.surahNumber; }
      else if (bm.type === 'hadith') { window.location.hash = '#/hadith/' + (bm.hadithId || ''); }
    }

    // Navigation
    function goHome() { window.location.hash = '#/'; }
    function goQuran() { window.location.hash = '#/quran'; }
    function goHadith() { window.location.hash = '#/hadith'; }
    function goSearch() { window.location.hash = '#/search'; }
    function goBookmarks() { window.location.hash = '#/bookmarks'; }
    function openSurah(num) { window.location.hash = '#/quran/' + num; }
    function openCollection(key) { window.location.hash = '#/hadith/' + key; }

    setTimeout(handleHashChange, 0);

    return {
      theme, isLight, isDark,
      isHome, isQuranList, isSurah, isHadithList, isHadithCollection, isSearch, isBookmarks,
      navHomeClass, navQuranClass, navHadithClass, navSearchClass, navBookmarksClass,
      toggleTheme,
      translations, currentTranslation, onTranslationChange,
      reciters, currentReciter, onReciterChange,
      allSurahs, quickSurahs, surahNumber, currentSurahNumber, currentSurahName, currentSurahType, currentSurahAyahCount,
      currentAyahs, isLoadingSurah, openSurah,
      playAyah, downloadAyahAudio,
